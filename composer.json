{
    "name": "waazdakka/users-map-location-osm",
    "description": "Display users location on OpenStreetMap. Fork of justoverclock/users-map-location.",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Waazdakka\\UsersMapLocationOsm\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Users Map Location (OSM)",
            "icon": {
                "name": "fas fa-map-marked-alt",
                "backgroundColor": "#2d8a4e",
                "color": "#fff"
            }
        }
    }
}
